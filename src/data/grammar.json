[
  {
    "id": "gr_be",
    "unitId": "u01",
    "title": {
      "en": "The verb 'be'",
      "hu": "A 'be' (lenni) ige"
    },
    "purpose": {
      "en": "Say who and what someone is."
    },
    "explanation": {
      "en": "Use am with I, is with he/she/it, are with you/we/they. Short forms: I'm, you're, he's.",
      "hu": "Az I mellett am, a he/she/it mellett is, a you/we/they mellett are áll. Rövid alakok: I'm, you're, he's."
    },
    "examples": [
      {
        "en": "I am Marta.",
        "hu": "Marta vagyok."
      },
      {
        "en": "She is my niece.",
        "hu": "Ő az unokahúgom."
      },
      {
        "en": "We are from Hungary.",
        "hu": "Magyarországról jövünk."
      }
    ],
    "useWhen": {
      "en": "Use this when you introduce yourself or describe people."
    },
    "check": {
      "question": "Choose: I ___ happy. (am / is)",
      "answer": "am"
    },
    "practice": [
      {
        "kind": "form",
        "text": "My niece Kira ___ in Denmark.",
        "answer": "is",
        "options": [
          "am",
          "is",
          "are"
        ],
        "hu": "Kira unokahúgom Dániában van."
      },
      {
        "kind": "type",
        "text": "I ___ a retired teacher.",
        "accepted": [
          "am",
          "'m"
        ],
        "hint": {
          "en": "I → am",
          "hu": "I mellett: am"
        },
        "hu": "Nyugdíjas tanár vagyok."
      },
      {
        "kind": "fix",
        "tokens": [
          "We",
          "is",
          "a",
          "happy",
          "family"
        ],
        "wrong": 1,
        "fix": "are",
        "hu": "Boldog család vagyunk."
      },
      {
        "kind": "say",
        "en": "I am a little nervous.",
        "hu": "Kicsit ideges vagyok."
      }
    ],
    "appearsIn": [],
    "needsReview": true
  },
  {
    "id": "gr_pronouns",
    "unitId": "u01",
    "title": {
      "en": "Subject pronouns",
      "hu": "Alanyi névmások"
    },
    "purpose": {
      "en": "Say who does something."
    },
    "explanation": {
      "en": "I, you, he, she, it, we, they replace names. Use he for a man, she for a woman.",
      "hu": "Az I, you, he, she, it, we, they a nevek helyett áll. He = férfi, she = nő."
    },
    "examples": [
      {
        "en": "He is Spanish.",
        "hu": "Ő spanyol."
      },
      {
        "en": "They live in Denmark.",
        "hu": "Ők Dániában élnek."
      }
    ],
    "useWhen": {
      "en": "Use this to talk about other people."
    },
    "check": {
      "question": "Endika is a man. He or she?",
      "answer": "he"
    },
    "practice": [
      {
        "kind": "form",
        "text": "Endika is from Spain. ___ is very kind.",
        "answer": "He",
        "options": [
          "He",
          "She",
          "They"
        ],
        "hu": "Endika Spanyolországból származik. Nagyon kedves."
      },
      {
        "kind": "form",
        "text": "Kira and Endika live in Denmark. ___ are happy.",
        "answer": "They",
        "options": [
          "We",
          "They",
          "She"
        ],
        "hu": "Kira és Endika Dániában él. Boldogok."
      },
      {
        "kind": "fix",
        "tokens": [
          "Kira",
          "is",
          "kind.",
          "Her",
          "is",
          "my",
          "niece"
        ],
        "wrong": 3,
        "fix": "She",
        "hu": "Kira kedves. Ő az unokahúgom."
      },
      {
        "kind": "say",
        "en": "She is my niece.",
        "hu": "Ő az unokahúgom."
      }
    ],
    "appearsIn": [],
    "needsReview": true
  },
  {
    "id": "gr_questions_wh",
    "unitId": "u01",
    "title": {
      "en": "Question words",
      "hu": "Kérdőszavak"
    },
    "purpose": {
      "en": "Ask for information."
    },
    "explanation": {
      "en": "What asks about things, Where about places, How about the way. The verb comes after the question word.",
      "hu": "A what dolgokra, a where helyre, a how módra kérdez. A kérdőszó után jön az ige."
    },
    "examples": [
      {
        "en": "What is your name?",
        "hu": "Hogy hívnak?"
      },
      {
        "en": "Where are you from?",
        "hu": "Honnan jössz?"
      },
      {
        "en": "How are you?",
        "hu": "Hogy vagy?"
      }
    ],
    "useWhen": {
      "en": "Use this to start a conversation with questions."
    },
    "check": {
      "question": "___ are you from? (What / Where)",
      "answer": "Where"
    },
    "practice": [
      {
        "kind": "form",
        "text": "___ are you from?",
        "answer": "Where",
        "options": [
          "What",
          "Where",
          "How"
        ],
        "hu": "Honnan jössz?"
      },
      {
        "kind": "form",
        "text": "___ is your name?",
        "answer": "What",
        "options": [
          "What",
          "Where",
          "When"
        ],
        "hu": "Hogy hívnak?"
      },
      {
        "kind": "type",
        "text": "___ are you? I'm fine, thank you.",
        "accepted": [
          "how"
        ],
        "hint": {
          "en": "asks about the way",
          "hu": "a módra kérdez"
        },
        "hu": "Hogy vagy? Jól vagyok, köszönöm."
      },
      {
        "kind": "say",
        "en": "Where is the gate, please?",
        "hu": "Hol van a beszállókapu, kérem?"
      }
    ],
    "appearsIn": [],
    "needsReview": true
  },
  {
    "id": "gr_articles",
    "unitId": "u01",
    "title": {
      "en": "a / an",
      "hu": "a / an (egy)"
    },
    "purpose": {
      "en": "Talk about one thing."
    },
    "explanation": {
      "en": "Use a before a consonant sound, an before a vowel sound: a teacher, an apple.",
      "hu": "Mássalhangzó előtt a, magánhangzó előtt an: a teacher, an apple."
    },
    "examples": [
      {
        "en": "I am a teacher.",
        "hu": "Tanár vagyok."
      },
      {
        "en": "It is an apple.",
        "hu": "Ez egy alma."
      }
    ],
    "useWhen": {
      "en": "Use this with jobs and single things."
    },
    "check": {
      "question": "___ egg (a / an)",
      "answer": "an"
    },
    "practice": [
      {
        "kind": "form",
        "text": "It is ___ apple.",
        "answer": "an",
        "options": [
          "a",
          "an"
        ],
        "hu": "Ez egy alma."
      },
      {
        "kind": "form",
        "text": "I am ___ teacher.",
        "answer": "a",
        "options": [
          "a",
          "an"
        ],
        "hu": "Tanár vagyok."
      },
      {
        "kind": "type",
        "text": "I would like ___ orange, please.",
        "accepted": [
          "an"
        ],
        "hint": {
          "en": "before a vowel sound → an",
          "hu": "magánhangzó előtt: an"
        },
        "hu": "Egy narancsot kérek."
      },
      {
        "kind": "fix",
        "tokens": [
          "Kira",
          "has",
          "a",
          "umbrella"
        ],
        "wrong": 2,
        "fix": "an",
        "hu": "Kirának van egy esernyője."
      }
    ],
    "appearsIn": [],
    "needsReview": true
  },
  {
    "id": "gr_possadj",
    "unitId": "u02",
    "title": {
      "en": "Possessive adjectives",
      "hu": "Birtokos névmások"
    },
    "purpose": {
      "en": "Say whose something is."
    },
    "explanation": {
      "en": "my, your, his, her, our, their show who owns something. His for a man, her for a woman.",
      "hu": "A my, your, his, her, our, their megmutatja, kié valami. His = férfié, her = nőé."
    },
    "examples": [
      {
        "en": "This is my family.",
        "hu": "Ez az én családom."
      },
      {
        "en": "Her name is Kira.",
        "hu": "Az ő neve Kira."
      }
    ],
    "useWhen": {
      "en": "Use this to talk about your family and things."
    },
    "check": {
      "question": "Kira is a woman. ___ name. (his / her)",
      "answer": "her"
    },
    "practice": [
      {
        "kind": "form",
        "text": "Kira is a woman. ___ boyfriend is Endika.",
        "answer": "Her",
        "options": [
          "His",
          "Her",
          "Their"
        ],
        "hu": "Kira nő. A barátja Endika."
      },
      {
        "kind": "form",
        "text": "This is ___ family. I love them.",
        "answer": "my",
        "options": [
          "my",
          "your",
          "his"
        ],
        "hu": "Ez az én családom. Szeretem őket."
      },
      {
        "kind": "type",
        "text": "David studies a lot. ___ subject is computer science.",
        "accepted": [
          "his"
        ],
        "hint": {
          "en": "a man → his",
          "hu": "férfié → his"
        },
        "hu": "David sokat tanul. A szakja informatika."
      },
      {
        "kind": "say",
        "en": "Her name is Kira.",
        "hu": "Az ő neve Kira."
      }
    ],
    "appearsIn": [],
    "needsReview": true
  },
  {
    "id": "gr_poss_s",
