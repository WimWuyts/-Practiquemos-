      "id": "snd_r",
      "stage": "stage-1",
      "order": 9,
      "focus": {
        "en": "The English 'r'",
        "hu": "Az angol 'r'"
      },
      "tip": {
        "en": "Soft, not rolled: right, red, three, sorry. British English often keeps it gentle.",
        "hu": "Lágy, nem pergetett: right, red, three, sorry. A brit angolban gyakran finom."
      },
      "examples": [
