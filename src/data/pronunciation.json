  "soundFocus": [
    {
      "id": "snd_short_vowels",
      "stage": "stage-1",
      "order": 1,
      "focus": {
        "en": "Short vowels",
        "hu": "Rövid magánhangzók"
      },
      "tip": {
        "en": "Listen to the short vowel in each word: cat, bed, sit, hot, cup. They are quick and clear.",
        "hu": "Figyeld a rövid magánhangzót: cat, bed, sit, hot, cup. Rövidek és tiszták."
      },
      "examples": [
        "cat",
        "bed",
        "sit",
        "hot",
        "cup"
      ],
      "minimalPairs": [
        {
          "a": "sit",
          "b": "set"
        },
        {
          "a": "cat",
          "b": "cut"
        }
      ]
    },
    {
      "id": "snd_long_vowels",
      "stage": "stage-1",
      "order": 2,
      "focus": {
        "en": "Long vowels",
        "hu": "Hosszú magánhangzók"
      },
      "tip": {
        "en": "Some vowels are longer: see, too, car, more. Let the sound last a little longer.",
        "hu": "Néhány magánhangzó hosszabb: see, too, car, more. Hagyd egy kicsit tovább szólni."
      },
      "examples": [
        "see",
        "too",
        "car",
        "more",
        "her"
      ],
      "minimalPairs": [
        {
          "a": "ship",
          "b": "sheep"
        },
        {
          "a": "full",
          "b": "fool"
        }
      ]
    },
    {
      "id": "snd_ee_i",
      "stage": "stage-1",
      "order": 3,
      "focus": {
        "en": "The 'ee' and 'i' sounds",
        "hu": "Az 'ee' és 'i' hang"
      },
      "tip": {
        "en": "Hear the difference: this (short) and these (long). English needs both.",
        "hu": "Halld a különbséget: this (rövid) és these (hosszú). Mindkettő kell."
      },
      "examples": [
        "this",
        "these",
        "it",
        "eat",
        "live",
        "leave"
      ],
      "minimalPairs": [
        {
          "a": "it",
          "b": "eat"
        },
        {
          "a": "live",
          "b": "leave"
        }
      ]
    },
    {
      "id": "snd_th",
      "stage": "stage-1",
      "order": 4,
      "focus": {
        "en": "The two 'th' sounds",
        "hu": "A két 'th' hang"
      },
      "tip": {
        "en": "Put your tongue lightly between your teeth. Soft: thank you, three. Voiced: this, mother.",
        "hu": "Tedd a nyelved lazán a fogaid közé. Lágy: thank you, three. Zöngés: this, mother."
      },
      "examples": [
        "thank you",
        "three",
        "this",
        "mother",
        "the"
      ],
      "minimalPairs": [
        {
          "a": "think",
          "b": "sink"
        },
        {
          "a": "three",
          "b": "tree"
        }
      ]
    },
    {
      "id": "snd_wv",
      "stage": "stage-1",
      "order": 5,
      "focus": {
        "en": "'w' and 'v'",
        "hu": "A 'w' és a 'v'"
      },
      "tip": {
        "en": "For w round your lips (water, we). For v put your teeth on your lip (very, visit).",
        "hu": "A w-nél kerekítsd az ajkad (water, we). A v-nél a fogad az ajkadhoz (very, visit)."
      },
      "examples": [
        "water",
        "we",
        "work",
        "very",
        "visit",
        "video"
      ],
      "minimalPairs": [
        {
          "a": "west",
          "b": "vest"
        },
        {
          "a": "wine",
          "b": "vine"
        }
      ]
    },
    {
      "id": "snd_h",
      "stage": "stage-1",
      "order": 6,
      "focus": {
        "en": "The 'h' sound",
        "hu": "A 'h' hang"
      },
      "tip": {
        "en": "Breathe out gently at the start: hello, home, help. Don't drop it.",
        "hu": "Lehelj ki finoman a szó elején: hello, home, help. Ne hagyd el."
      },
      "examples": [
        "hello",
        "home",
        "help",
        "have",
        "how"
      ],
      "minimalPairs": [
        {
          "a": "eat",
          "b": "heat"
        },
        {
          "a": "and",
          "b": "hand"
        }
      ]
    },
    {
      "id": "snd_shchj",
      "stage": "stage-1",
      "order": 7,
      "focus": {
        "en": "'sh', 'ch' and 'j'",
        "hu": "A 'sh', 'ch' és 'j'"
