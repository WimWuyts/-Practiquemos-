  "soundFocus": [
    {
      "id": "pf_th",
      "focus": {
        "en": "The 'th' sound",
        "hu": "A 'th' hang"
      },
      "tip": {
        "en": "Put your tongue lightly between your teeth for th in the, three, thank you.",
        "hu": "A th-nál (the, three, thank you) tedd a nyelved lazán a fogaid közé."
      },
      "examples": [
        "the",
        "three",
        "thank you",
        "this",
        "mother"
      ],
      "minimalPairs": [
        {
          "a": "think",
          "b": "sink"
        },
        {
          "a": "three",
          "b": "tree"
        }
      ]
    },
    {
      "id": "pf_wv",
      "focus": {
        "en": "'w' and 'v'",
        "hu": "A 'w' és a 'v'"
      },
      "tip": {
        "en": "For w round your lips (water). For v use your teeth on your lip (very).",
        "hu": "A w-nél kerekítsd az ajkad (water). A v-nél a fogad az ajkadhoz (very)."
      },
      "examples": [
        "water",
        "we",
        "work",
        "very",
        "visit",
        "video"
      ],
      "minimalPairs": [
        {
          "a": "west",
          "b": "vest"
        },
        {
          "a": "wine",
          "b": "vine"
        }
      ]
    },
    {
      "id": "pf_finals",
      "focus": {
        "en": "Final -s endings",
        "hu": "A szóvégi -s"
      },
      "tip": {
        "en": "Listen to the last sound: books, names, buses. Three gentle patterns, not a rule to memorise.",
        "hu": "Figyeld az utolsó hangot: books, names, buses. Három lágy minta, nem szabály."
      },
      "examples": [
        "books",
        "names",
        "buses",
        "sisters",
        "watches"
      ],
      "minimalPairs": []
    },
    {
      "id": "pf_ed",
      "focus": {
        "en": "Past -ed endings",
        "hu": "A múlt idő -ed vége"
      },
      "tip": {
        "en": "Listen: visited, cooked, lived. Three gentle patterns, not a rule to memorise.",
        "hu": "Figyeld: visited, cooked, lived. Három lágy minta, nem szabály."
      },
      "examples": [
        "visited",
        "cooked",
        "lived",
        "worked",
        "wanted"
      ],
      "minimalPairs": []
    },
    {
      "id": "pf_stress",
      "focus": {
        "en": "Word stress",
        "hu": "Szóhangsúly"
      },
      "tip": {
        "en": "One part of the word is stronger: HO-tel, com-PU-ter, a-FRAID.",
        "hu": "A szó egyik része erősebb: HO-tel, com-PU-ter, a-FRAID."
      },
      "examples": [
        "hotel",
        "computer",
        "afraid",
        "restaurant",
        "family"
      ],
      "minimalPairs": []
    },
    {
      "id": "pf_question",
      "focus": {
        "en": "Question and statement melody",
        "hu": "Kérdés és kijelentés dallama"
      },
      "tip": {
        "en": "Many yes/no questions go up at the end. Wh-questions usually go down.",
        "hu": "Sok eldöntendő kérdés a végén felmegy. A kérdőszós kérdés általában lemegy."
      },
      "examples": [
        "Can you hear me?",
        "Where is my gate?",
        "Are you ready?"
      ],
      "minimalPairs": []
    }
