{
  "path": {
    "intro": {
      "en": "We learn pronunciation in two steps. First we listen to the sounds of English, using easy example words — no strange symbols. Then we look at how English spelling and sound fit together, which is the tricky part.",
      "hu": "A kiejtést két lépésben tanuljuk. Először meghallgatjuk az angol hangokat egyszerű példaszavakkal — furcsa jelek nélkül. Utána megnézzük, hogyan illik össze az angol írás és kiejtés — ez a nehéz rész."
    },
    "stages": [
      {
        "id": "stage-1",
        "label": {
          "en": "Step 1 · The sounds",
          "hu": "1. lépés · A hangok"
        }
      },
      {
        "id": "stage-2",
        "label": {
          "en": "Step 2 · Spelling & sound",
          "hu": "2. lépés · Írás és kiejtés"
        }
      },
      {
        "id": "stage-3",
        "label": {
          "en": "Step 3 · Stress & melody",
          "hu": "3. lépés · Hangsúly és dallam"
        }
      }
    ]
  },
