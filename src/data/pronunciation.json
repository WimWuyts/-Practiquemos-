          "b": "jeep"
        }
      ]
    },
    {
      "id": "snd_ng",
      "stage": "stage-1",
      "order": 8,
      "focus": {
        "en": "The 'ng' sound",
        "hu": "Az 'ng' hang"
      },
      "tip": {
        "en": "One soft sound at the back, no hard g: morning, evening, going, thing.",
        "hu": "Egy lágy hang hátul, kemény g nélkül: morning, evening, going, thing."
